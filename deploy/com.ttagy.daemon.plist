<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ttagy.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/ttagyd</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8970</string>
        <string>--token</string>
        <string>ttagy-default-secret</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/ttagyd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ttagyd.err.log</string>
</dict>
</plist>
